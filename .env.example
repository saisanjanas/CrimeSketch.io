# API server
PORT=4100
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_nexus_forensics
JWT_SECRET=replace-with-a-long-random-secret
UPLOAD_DIR=./server/private_uploads
MAX_UPLOAD_MB=25

# Email OTP / verification. Login intentionally fails closed if mail is not configured.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-user
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM=CrimeSketch.io <no-reply@example.com>

# Local Gemma via Ollama. Example local model tag should match `ollama list`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Optional remote provider adapters — server-side only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
STABLE_DIFFUSION_API_URL=
STABLE_DIFFUSION_API_KEY=
WHISPER_API_URL=
WHISPER_API_KEY=
HITEM3D_API_URL=
HITEM3D_API_KEY=
